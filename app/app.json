{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera for video consultations",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for video consultations"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "CAMERA",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255946",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "@videosdk.live/expo-config-plugin",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for video consultations",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for video consultations"
        }
      ]
    ],
    "experiments": {},
    "extra": {
      "apiUrl": "https://api.janki.care"
    }
  }
}
