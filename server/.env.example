# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/digital-clinic
# Optional separate analytics DB (Super Admin). Falls back to null if unset.
ANALYTICS_MONGODB_URI=

JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Portals / CORS ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SUPER_ADMIN_URL=http://localhost:5175

# ── Infra ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Storage (Phase 4 docs / Phase 7 vault / prescription PDFs) ──────────────
# driver: local (default) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY=900

# ── Payments — Razorpay (Phase 4 + 5) ───────────────────────────────────────
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI — Gemini (Phase 6) ───────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=1024

# ── Brevo (Email OTP Verification) ──────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@janki.care
BREVO_SENDER_NAME=Janki Care

# ── Feature flags (ship phases dark; enable per-environment) ────────────────
FEATURE_DOCTOR_APPROVAL=false
FEATURE_PATIENT_SUBSCRIPTION=false
FEATURE_AI=false
FEATURE_VAULT=false

# VideoSDK (Video Consultations)
VIDEOSDK_ENABLED=true
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=
VIDEOSDK_API_BASE=https://api.videosdk.live
VIDEOSDK_TOKEN_TTL=7200